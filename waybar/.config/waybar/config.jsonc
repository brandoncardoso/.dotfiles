{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 8,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  "modules-left": ["niri/workspaces", "niri/window", "privacy"],
  "modules-center": ["mpris"],
  "modules-right": [
    "temperature",
    "cpu",
    "memory",
    "battery",
    "tray",
    "network",
    "backlight",
    "pulseaudio",
    "clock",
  ],

  "niri/workspaces": {
    "format": "{value}",
    "disable-click": true,
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
  },

  "privacy": {
    "icon-size": 16,
    "modules": [
      { "type": "screenshare" },
      { "type": "audio-in" },
    ],
  },

  "mpris": {
    "interval": 1,
	"format": "{player_icon} {dynamic}",
	"format-paused": "{status_icon} <i>{dynamic}</i>",
	"player-icons": {
		"default": "▶",
		"mpv": "🎵"
	},
	"status-icons": {
		"paused": "⏸"
	},
  },

  "temperature": {
    "format": "{temperatureC}°C",
    "warning-threshold": 42,
    "critical-threshold": 45,
    "tooltip": false,
  },

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format": "Mem {percentage}%",
    "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used\n{swapUsed}GiB / {swapTotal}GiB swap",
  },

  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "smooth-power": true,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}",
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'",
      "on-discharging": "notify-send -u normal 'Power Switch' Discharging",
      "on-charging": "notify-send -u normal 'Power Switch' Charging'"
    },
  },

  "backlight": {
    "min": 5,
    "max": 100,
    "format": "⬤",
    "tooltip-format": "Brightness {percent}%",

  },

  "clock": {
    "interval": 1,
    "format": "{:%F %T}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<b>{}</b>",
        "today": "<b><u>{}</u></b>",
      },
    },
  },

  "tray": {
    "icon-size": 16,
    "spacing": 4,
  },


  "pulseaudio": {
    "format": "{icon}",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer --toggle-mute",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 1,
    "reverse-scrolling": true,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""],
    },
  },


  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
  },
}
